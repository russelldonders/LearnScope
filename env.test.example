# LearnScope end-to-end test configuration
# Copy this file to env.test and replace the placeholder values.
# Use staging accounts and synthetic data only.
# Authenticated Playwright projects activate only when the staging URL and
# learner credentials below are all configured.
# Set E2E_AUTHENTICATED=false for an explicit public-only local run.

E2E_BASE_URL=https://your-staging-url.vercel.app
E2E_AUTHENTICATED=true

# Standard learner account
E2E_LEARNER_EMAIL=learner-test@example.com
E2E_LEARNER_PASSWORD=replace-with-a-unique-test-password

# Manager account (optional)
E2E_MANAGER_EMAIL=manager-test@example.com
E2E_MANAGER_PASSWORD=replace-with-a-unique-test-password

# Organisation administrator account (optional)
E2E_ADMIN_EMAIL=admin-test@example.com
E2E_ADMIN_PASSWORD=replace-with-a-unique-test-password

# Safety guard used by Playwright. Non-local authenticated runs must target a
# hostname containing "staging" unless this is deliberately set to true.
E2E_ALLOW_PRODUCTION=false
