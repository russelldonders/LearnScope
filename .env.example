VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Strava connector (see src/pages/ConnectedAccounts.jsx) -- create an app at
# https://www.strava.com/settings/api. Client ID is public (used to build
# the client-side authorize URL); Client Secret is server-only and must
# also be set as STRAVA_CLIENT_SECRET wherever api/strava/[...path].js runs
# (Vercel env vars), never committed here.
VITE_STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
